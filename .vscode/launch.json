{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Recorder Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/extension", "--extensionDevelopmentPath=${workspaceFolder}/extension/devReloader"],
      "env": {
        "RECORDER_EXTENSION_BUNDLE": "${workspaceFolder}/extension/dist/extension.cjs"
      },
      "outFiles": ["${workspaceFolder}/extension/dist/**/*.cjs"],
      "preLaunchTask": "watch: recorder extension"
    }
  ]
}
